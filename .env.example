# StatusC0rd environment template (multi-user).
#
# Everything is optional. The dashboard stores the same values in data/data.json,
# and an environment value always wins - which is why hosts with a wiped disk
# (Render free, for instance) ask for these in the environment instead.
#
# Copy to .env for local runs; the full free walkthrough is SETUP.md.

# Cookie signing secret. Generated and persisted if unset; set it when the disk
# does not survive restarts, or every restart signs everyone out anyway.
SESSION_SECRET=

# Public HTTPS origin of this deployment - photo URLs, the keep-alive and the
# public card pages. No trailing slash. Render supplies RENDER_EXTERNAL_URL
# automatically; set PUBLIC_URL only for a custom domain.
PUBLIC_URL=

# The Discord application: id (public), OAuth2 client secret (private) and the
# bot token (private - only for the admin's 24/7 text card).
CLIENT_ID=
CLIENT_SECRET=
DISCORD_TOKEN=

# BOT_ENABLED=false runs the dashboard without the gateway connection.
BOT_ENABLED=

# Admins (comma-separated Discord ids): the instance panel, the bot card and
# the keep-alive. Unset means the first account to sign in becomes the admin.
ADMIN_DISCORD_IDS=

# The name in the header, titles and card pages. 2-40 characters; a 0 keeps the
# branded zero. Blank means StatusC0rd.
SITE_NAME=

# Support server invite shown in Account Center (https://discord.gg/...).
# Admins can also set it in the dashboard's Instance panel.
SUPPORT_URL=

# Keep the free host awake: pings PUBLIC_URL/health on a schedule.
# Interval clamped to 5-60 minutes.
KEEP_ALIVE=
KEEP_ALIVE_INTERVAL_MINUTES=

# Rarely needed: DATA_DIR (./data), PORT (3000), LOG_REQUESTS (on),
# TRUST_PROXY (auto in production), NODE_ENV.
DATA_DIR=
PORT=
LOG_REQUESTS=
