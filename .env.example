# StatusC0rd environment template
#
# Copy this to `.env` (next to index.js) and fill in what you need.
#
# Every variable here is OPTIONAL. The setup wizard writes the same values into
# data/settings.json, and a value in this file always wins over the wizard - which
# is why the managed hosts in SETUP.md Part 2 ask for these: the environment
# survives a wiped disk, the JSON file does not.
#
# Each one is documented once in SETUP.md, Part 12.
#
# The ones people actually set on a managed host, because they survive a wiped
# disk (Render free, for instance):

# Public HTTPS origin of this deployment. Required for photo URLs and for the
# keep-alive. No trailing slash.
PUBLIC_URL=

# The dashboard key. Setting it also marks the instance configured, so the
# setup wizard is skipped on first boot. 12+ characters.
DASHBOARD_KEY=

# The Discord application: ID (public), OAuth2 client secret (private) and the
# bot token (private, only needed for the 24/7 text card).
CLIENT_ID=
CLIENT_SECRET=
DISCORD_TOKEN=

# Where settings.json, assets/ and setup-token.txt live. Defaults to ./data.
DATA_DIR=

# HTTP port. Defaults to 3000.
PORT=

# Everything else is rarely needed, and Part 12 of SETUP.md covers each one:
#   NODE_ENV  SESSION_SECRET  SETUP_TOKEN  SETUP_REQUIRE_TOKEN
#   ALLOWED_DISCORD_IDS  BOT_ENABLED  KEEP_ALIVE  KEEP_ALIVE_INTERVAL_MINUTES
#   REDIRECT_URI  TRUST_PROXY  LOG_REQUESTS
