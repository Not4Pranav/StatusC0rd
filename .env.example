# StatusC0rd environment (ALL OPTIONAL)
#
# You do not need this file: the server starts with no configuration and shows
# a setup wizard at /setup. Variables set here (or in your host's dashboard)
# take precedence over what the website has stored.

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Where settings and uploaded images live. Defaults to ./data
DATA_DIR=

# --- Discord application ----------------------------------------------------
# Application/client ID (public). The bundled app is VanC0rd:
# CLIENT_ID=1554342719923560518
CLIENT_ID=
APPLICATION_ID=1554342719923560518
PUBLIC_KEY=cd1c10dd26d6f42bf638c40bb2d556077df764ebade5f23cf09cbaec4b8d14cc

# --- Discord bot (private) --------------------------------------------------
# Bot token from Developer Portal -> Bot -> Reset Token.
# Leave empty to configure it in the setup wizard instead.
DISCORD_TOKEN=
# Set to false to run the dashboard without a bot.
BOT_ENABLED=true

# --- Dashboard auth ---------------------------------------------------------
# Signs the session cookie. Generated automatically when not set.
SESSION_SECRET=
# Dashboard sign-in key. If unset, the setup wizard asks you to create one.
DASHBOARD_KEY=
# Optional: print/require this token for the setup wizard even on localhost.
SETUP_TOKEN=

# --- Optional: Discord sign-in ---------------------------------------------
CLIENT_SECRET=
ALLOWED_DISCORD_IDS=

# --- Public URL and 24/7 keep-awake ----------------------------------------
# Public HTTPS URL of this deployment. Needed for image hosting and keep-awake.
PUBLIC_URL=
KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_MINUTES=10
# OAuth callback; defaults to <PUBLIC_URL>/auth/discord/callback
REDIRECT_URI=
