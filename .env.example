# StatusC0rd configuration
# Copy to `.env` and fill in the private values. Never commit `.env`.

# --- Discord application (public identifiers) -------------------------------
CLIENT_ID=1554342719923560518
APPLICATION_ID=1554342719923560518
PUBLIC_KEY=cd1c10dd26d6f42bf638c40bb2d556077df764ebade5f23cf09cbaec4b8d14cc

# --- Discord bot (private) --------------------------------------------------
# Bot token from Developer Portal -> Bot -> Reset Token.
DISCORD_TOKEN=
# Set to false to run the dashboard without connecting a bot (useful for local UI work).
BOT_ENABLED=true

# --- Dashboard auth ---------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Password for the dashboard sign-in form. Generate with: openssl rand -hex 32
DASHBOARD_KEY=

# --- Optional: Discord sign-in ---------------------------------------------
# OAuth2 client secret (Developer Portal -> OAuth2).
CLIENT_SECRET=
# Comma separated Discord user IDs allowed to sign in with Discord.
ALLOWED_DISCORD_IDS=

# --- OAuth redirect ---------------------------------------------------------
# Must exactly match a redirect URL registered in Developer Portal -> OAuth2.
# Leave empty to derive it from the request host (fine for local development).
REDIRECT_URI=http://localhost:3000/auth/discord/callback

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Where config.json is stored. Defaults to ./data
DATA_DIR=
# Express "trust proxy" setting. Defaults to 1 in production, off otherwise.
TRUST_PROXY=
