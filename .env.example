# StatusC0rd environment template - every value here is OPTIONAL.
#
# The complete explanation of each variable, when to use it and what breaks
# without it is section 17 of docs/setup.md (served by the app at /guide).
# Nothing needs to be set: the server boots bare and serves a setup wizard at
# /setup. Environment values simply win over what the website stored.

# --- server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Where settings.json and the uploaded photos live. Defaults to ./data
DATA_DIR=

# --- Discord application ----------------------------------------------------
# Application (client) ID from General Information. Public, not a secret.
CLIENT_ID=
# OAuth2 client secret. Enables the in-Discord app and "Continue with Discord".
CLIENT_SECRET=

# --- Discord bot (private) --------------------------------------------------
# Bot token from Developer Portal -> Bot -> Reset Token. Optional: it only adds
# the text card that stays online 24/7.
DISCORD_TOKEN=
# Set to false to run the dashboard without a gateway connection. Left unset the
# bot is enabled exactly when a token exists.
# BOT_ENABLED=false

# --- dashboard auth ---------------------------------------------------------
# Signs the session cookie. Generated and stored automatically when unset.
SESSION_SECRET=
# The sign-in key. Setting it also marks the instance configured, so the setup
# wizard is skipped on first boot.
DASHBOARD_KEY=
# Pin the one-time setup token instead of the generated one.
SETUP_TOKEN=
# Set to 1 to demand the setup token even from localhost.
# SETUP_REQUIRE_TOKEN=1

# --- optional: Discord sign-in ---------------------------------------------
# Comma separated Discord user IDs allowed to sign in without the key.
ALLOWED_DISCORD_IDS=
# OAuth callback; defaults to <PUBLIC_URL>/auth/discord/callback
REDIRECT_URI=

# --- public URL and the 24/7 keep-alive ------------------------------------
# Public HTTPS origin of this deployment. Required for photo URLs and keep-alive.
PUBLIC_URL=
# Keep-alive only runs when PUBLIC_URL is set. Unset it to follow whatever the
# dashboard stored (ticked by default).
# KEEP_ALIVE=true
# KEEP_ALIVE_INTERVAL_MINUTES=10

# --- reverse proxy ----------------------------------------------------------
# Which hops may set X-Forwarded-For / X-Forwarded-Proto. Defaults to
# "loopback, linklocal, uniquelocal" (Render, Cloudflare, Caddy on the same
# host). Use false when the app is exposed directly to the internet.
TRUST_PROXY=
